# ===== 店铺配置:复制为 .env 后修改 =====
# 后台管理密码(上线前务必改掉)
# 后台管理密码:留空不填则首次启动自动生成,密码见启动日志或 data/.admin_password
# 想用自己的密码就取消注释并填上:
# ADMIN_PASSWORD=你的密码

# Flask 会话密钥,留空则自动生成并保存在 data/.secret
# SECRET_KEY=

# ===== 支付配置(现在后台「支付」里改,这里只做首次建库的初始值) =====
# 下面四项只在第一次启动(数据库为空)时导入后台,之后改配置请去后台「支付」页,
# 改 .env 不会再生效。如需重新导入,删掉 data/shop.db 后重启。
# EPAY_URL=https://pay.example.com
# EPAY_PID=
# EPAY_KEY=
# EPAY_TYPES=alipay:支付宝,wxpay:微信支付

# 站点对外地址(用于生成回调地址)。建议填上你的 HTTPS 域名,填了后会话 Cookie 更安全。
# SITE_URL=https://shop.example.com

# 端口与数据库
PORT=8000
# DB_PATH=data/shop.db

# 演示数据:首次建库时写入演示分类/商品/卡密,正式开店请设为 0 或删除
DEMO_SEED=0
